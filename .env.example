# Reference only: export these variables explicitly; no .env is loaded by default.
VOICEPILOT_APP_NAME=VoicePilot
VOICEPILOT_ENVIRONMENT=development
VOICEPILOT_DEBUG=false
VOICEPILOT_LOG_LEVEL=INFO
VOICEPILOT_DATA_DIR=data
VOICEPILOT_LOG_DIR=logs
VOICEPILOT_LLM_PROVIDER=disabled
VOICEPILOT_OLLAMA_BASE_URL=http://localhost:11434
VOICEPILOT_WAKE_WORD_ENABLED=false
VOICEPILOT_SPEAKER_VERIFICATION_ENABLED=false
VOICEPILOT_WHISPER_MODEL=small
VOICEPILOT_WHISPER_DEVICE=cpu
VOICEPILOT_WHISPER_COMPUTE_TYPE=int8
VOICEPILOT_MAX_PLAN_STEPS=10
VOICEPILOT_MAX_RETRIES=2
VOICEPILOT_TASK_TIMEOUT_SECONDS=60

VOICEPILOT_AUDIO_SAMPLE_RATE=16000
VOICEPILOT_AUDIO_CHANNELS=1
VOICEPILOT_AUDIO_DTYPE=int16
VOICEPILOT_AUDIO_BLOCK_SIZE=1024
VOICEPILOT_AUDIO_MAX_DURATION_SECONDS=120
# default uses the OS default input; otherwise use a device index or exact name.
VOICEPILOT_AUDIO_INPUT_DEVICE=default
VOICEPILOT_RECORDINGS_DIR=recordings
VOICEPILOT_RECORDING_PERSISTENCE_ENABLED=false

VOICEPILOT_STT_LANGUAGE=auto
VOICEPILOT_STT_VAD_FILTER=true
VOICEPILOT_STT_WORD_TIMESTAMPS=false
VOICEPILOT_STT_BEAM_SIZE=5
VOICEPILOT_STT_MAX_DURATION_SECONDS=120
VOICEPILOT_STT_MODEL_DIR=models/whisper
# true prohibits model downloads; the model and tokenizer must already be cached.
VOICEPILOT_STT_LOCAL_FILES_ONLY=false

VOICEPILOT_AUDIO_SILENCE_STOP_ENABLED=false
VOICEPILOT_AUDIO_SILENCE_DURATION_SECONDS=2
VOICEPILOT_AUDIO_SILENCE_THRESHOLD=0.01
VOICEPILOT_STT_TEMPERATURE=0
VOICEPILOT_STT_VAD_MIN_SILENCE_DURATION_MS=1000
VOICEPILOT_STT_INITIAL_PROMPT="VoicePilot, Spotify, WhatsApp, Chrome, YouTube."
VOICEPILOT_STT_HOTWORDS="VoicePilot Spotify WhatsApp Chrome YouTube"

# Phase 3C: unvalidated output-safety engineering defaults (always enabled)
VOICEPILOT_STT_SAFETY_WORD_REPETITIONS=8
VOICEPILOT_STT_SAFETY_PHRASE_REPETITIONS=4
VOICEPILOT_STT_SAFETY_PHRASE_MIN_TOKENS=16
VOICEPILOT_STT_SAFETY_MIN_TOKENS=30
VOICEPILOT_STT_SAFETY_TOKENS_PER_SECOND=6.0
VOICEPILOT_STT_SAFETY_MIN_CHARACTERS=180
VOICEPILOT_STT_SAFETY_CHARACTERS_PER_SECOND=40.0
VOICEPILOT_STT_SAFETY_NO_SPEECH_PROB=0.8
VOICEPILOT_STT_SAFETY_AVG_LOGPROB=-1.0
VOICEPILOT_STT_SAFETY_MAX_SEGMENTS=256
VOICEPILOT_STT_SAFETY_MAX_OUTPUT_CHARACTERS=8192

# Phase 3E: opt-in public contextual vocabulary; no private overlay autoload
VOICEPILOT_STT_CONTEXTUAL_ENABLED=false

# Speaker engineering defaults; real authorization requires separate private policy review.
VOICEPILOT_SPEAKER__SAMPLE_RATE=16000
VOICEPILOT_SPEAKER__EMBEDDING_DIMENSION=256
VOICEPILOT_SPEAKER__MIN_SAMPLES=3
VOICEPILOT_SPEAKER__MAX_SAMPLES=5
VOICEPILOT_SPEAKER__ENROLLMENT_SAMPLES=4
VOICEPILOT_SPEAKER__MIN_DURATION=3
VOICEPILOT_SPEAKER__MAX_DURATION=30
VOICEPILOT_SPEAKER__MIN_RMS=0.005
VOICEPILOT_SPEAKER__MAX_CLIPPING=0.01
VOICEPILOT_SPEAKER__CONSISTENCY_THRESHOLD=0.7
VOICEPILOT_SPEAKER__POLICY_VERSION=calibration-pending
VOICEPILOT_SPEAKER__LOCAL_FILES_ONLY=true
VOICEPILOT_SPEAKER__SECURE_PROFILES_REQUIRED=true
# Acceptance/rejection thresholds, profile/model/policy paths remain unset.

# Phase 4B: real local backend; no automatic model download or profile enrollment.
VOICEPILOT_SPEAKER__BACKEND=sherpa-onnx
VOICEPILOT_SPEAKER__MODEL_ID=wespeaker-resnet34
VOICEPILOT_SPEAKER__CHECKSUM=5ef208a9da1453335308a6b6f4e6dfbd7e183a38b604de0a57664f45d257fe94
VOICEPILOT_SPEAKER__CHECKSUM_TYPE=publisher-sha256
VOICEPILOT_SPEAKER__CAPTURE_DURATION=8
VOICEPILOT_SPEAKER__MAX_RETRIES=2
VOICEPILOT_SPEAKER__CALIBRATION_STATE=pending
VOICEPILOT_SPEAKER__DIAGNOSTICS=false
# Optional nested MODEL_PATH, PROFILE_ROOT, CALIBRATION_ROOT, DEFAULT_PROFILE_ID.
# Profile/calibration defaults are under LOCALAPPDATA/VoicePilot, outside OneDrive.
# Select a protected reviewed policy explicitly with --policy UUID.
# POLICY_PATH, configured threshold/calibration values do not grant authorization.
# Scores require explicit --diagnostics, regardless of the diagnostics setting.

# Phase 5A: deterministic planning and diagnostics, never execution.
VOICEPILOT_PLANNING__ENABLED=true
VOICEPILOT_PLANNING__VERSION=5a-v1
VOICEPILOT_PLANNING__MAX_STEPS=10
VOICEPILOT_PLANNING__MAX_DEPTH=8
VOICEPILOT_PLANNING__MAX_RETRIES=1
VOICEPILOT_PLANNING__STEP_TIMEOUT=10
VOICEPILOT_PLANNING__TOTAL_TIMEOUT=120
VOICEPILOT_PLANNING__CONFIRMATION_EXPIRY=120
VOICEPILOT_PLANNING__SIMULATION_ONLY=true
VOICEPILOT_PLANNING__TRACE_SAVING_ENABLED=false
VOICEPILOT_PLANNING__AUDIO_SAVING_ENABLED=false
VOICEPILOT_PLANNING__MAX_AUDIO_DURATION=30
VOICEPILOT_PLANNING__MAX_TRACE_BYTES=65536
VOICEPILOT_PLANNING__SESSION_LIMIT=5
# Optional VOICEPILOT_PLANNING__TRACE_ROOT: absolute nonsynced private directory.
# Default: LOCALAPPDATA/VoicePilot/diagnostics (resolved only on explicit artifact access).
# CLI --save-audio/--save-trace enable only that invocation; every write also asks consent.
# Environment saving flags alone never start persistence or capture.
# New planning limits are authoritative for 5A; older top-level plan limits are reserved.

# Phase 5B: immutable production-off, fake-only execution-control foundation.
VOICEPILOT_EXECUTION__ENABLED=false
VOICEPILOT_EXECUTION__FAKE_ONLY=true
VOICEPILOT_EXECUTION__POLICY_VERSION=5b-v1
VOICEPILOT_EXECUTION__TIMEOUT_SECONDS=5
VOICEPILOT_EXECUTION__MAX_RETRIES=1
VOICEPILOT_EXECUTION__EVIDENCE_TTL=60
VOICEPILOT_EXECUTION__MAX_ENTRIES=1000
# No production adapter/issuer or audit persistence exists.


# Phase 6A: fixed Windows launch; manual operation still requires typed consent.
VOICEPILOT_LAUNCH__REAL_EXECUTION_ENABLED=false
VOICEPILOT_LAUNCH__WINDOWS_ADAPTER_ENABLED=true
VOICEPILOT_LAUNCH__MANUAL_LAUNCH_TESTING_ENABLED=true
VOICEPILOT_LAUNCH__APPROVED_APPLICATION_IDS=["notepad","calculator","chrome","spotify"]
VOICEPILOT_LAUNCH__DISCOVERY_TIMEOUT=5
VOICEPILOT_LAUNCH__LAUNCH_TIMEOUT=5
VOICEPILOT_LAUNCH__OBSERVATION_TIMEOUT=5
VOICEPILOT_LAUNCH__AUTHORIZATION_EXPIRY=30
VOICEPILOT_LAUNCH__MAXIMUM_APPLICATIONS=1
VOICEPILOT_LAUNCH__ARGUMENTS_ALLOWED=false
VOICEPILOT_LAUNCH__ELEVATION_ALLOWED=false
# No automated launches; authenticated voice requires protected approved calibration.


# Phase 6B: real controls and screenshots are opt-in; manual consent is still required.
VOICEPILOT_OPERATIONS__ENABLED=false
VOICEPILOT_OPERATIONS__MANUAL_TESTING_ENABLED=true
VOICEPILOT_OPERATIONS__SCREENSHOT_ENABLED=false
VOICEPILOT_OPERATIONS__VOLUME_STEP=5
VOICEPILOT_OPERATIONS__BRIGHTNESS_STEP=5
VOICEPILOT_OPERATIONS__VOLUME_TOLERANCE=0.5
VOICEPILOT_OPERATIONS__OPERATION_TIMEOUT=5
VOICEPILOT_OPERATIONS__OBSERVATION_TIMEOUT=2
VOICEPILOT_OPERATIONS__AUTHORIZATION_EXPIRY=30
VOICEPILOT_OPERATIONS__HISTORY_LIMIT=100
VOICEPILOT_OPERATIONS__MAXIMUM_ACTIONS=1
# Screenshot directory is fixed internally, never a configurable user path.


# Phase 6B.1: enabling a flag does not approve owner calibration.
VOICEPILOT_OWNER__CALIBRATION_ENABLED=false
VOICEPILOT_OWNER__PILOT_ENABLED=false
VOICEPILOT_OWNER__PHRASE_VERSION=owner-phrases-v1
VOICEPILOT_OWNER__CHALLENGE_EXPIRY=45
VOICEPILOT_OWNER__AUTHENTICATION_TTL=60
VOICEPILOT_OWNER__INACTIVITY_TIMEOUT=30
VOICEPILOT_OWNER__MAXIMUM_COMMANDS=1
VOICEPILOT_OWNER__MINIMUM_OWNER_SAMPLES=8
VOICEPILOT_OWNER__MINIMUM_HOLDOUT_SAMPLES=4
VOICEPILOT_OWNER__MINIMUM_NONOWNER_SAMPLES=20
VOICEPILOT_OWNER__MINIMUM_NONOWNER_SPEAKERS=3
VOICEPILOT_OWNER__MINIMUM_REPLAY_TRIALS=3
VOICEPILOT_OWNER__ACCEPTANCE_FLOOR=0.80
VOICEPILOT_OWNER__REJECTION_FLOOR=0.70
VOICEPILOT_OWNER__UNCERTAINTY_BAND=0.10
VOICEPILOT_OWNER__MINIMUM_ACTIVE_SECONDS=1.5
VOICEPILOT_OWNER__MINIMUM_ACTIVE_FRACTION=0.4
VOICEPILOT_OWNER__SAVE_RAW_AUDIO=false
VOICEPILOT_OWNER__ALLOWLIST_VERSION=owner-pilot-v1
